{
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[django-html]": {},
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "accessibility.signals.terminalBell": {
        "sound": "off",
        "announcement": "off"
    },
    "accessibility.signals.terminalCommandFailed": {
        "sound": "on"
    },
    "chat.disableAIFeatures": true,
    "cSpell.userWords": [
        "autoref",
        "djhtml",
        "JINJABASE",
        "venv"
    ],
    "debug.console.fontFamily": "FiraCode Nerd Font",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderGutterMenu": true,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "off",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "block",
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.find.autoFindInSelection": "multiline",
    "editor.fontFamily": "FiraCode Nerd Font",
    "editor.fontLigatures": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.guides.bracketPairs": false,
    "editor.inlayHints.enabled": "off",
    "editor.inlineSuggest.showToolbar": "always",
    "editor.lineNumbers": "on",
    "editor.linkedEditing": true,
    "editor.minimap.autohide": "scroll",
    "editor.renderControlCharacters": true,
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "all",
    "editor.selectionHighlight": true,
    "editor.smoothScrolling": true,
    "editor.tabCompletion": "on",
    "editor.wordWrap": "off",
    "emmet.triggerExpansionOnTab": true,
    "emmet.useInlineCompletions": true,
    "explorer.autoReveal": "focusNoScroll",
    "files.associations": {
        "djhtml": "django-html"
    },
    "files.autoSave": "afterDelay",
    "files.defaultLanguage": "${activeEditorLanguage}",
    "files.trimTrailingWhitespace": true,
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": true,
    "git.blame.statusBarItem.enabled": true,
    "git.detectWorktrees": true,
    "git.fetchOnPull": true,
    "git.pruneOnFetch": true,
    "git.untrackedChanges": "separate",
    "html.format.indentInnerHtml": true,
    "js/ts.suggest.paths": false,
    "json.schemaDownload.trustedDomains": {
        "https://biomejs.dev": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "python-envs.terminal.showActivateButton": true,
    "python.terminal.activateEnvironment": false,
    "remote.tunnels.access.preventSleep": true,
    "terminal.integrated.allowChords": false,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.fontFamily": "FiraCode Nerd Font",
    "terminal.integrated.profiles.linux": {
        "Aider AI": {
            "args": [
                "-c",
                "export OLLAMA_API_BASE=http://localhost:11434; aider --model ollama/aider-coder; exec bash"
            ],
            "icon": "robot",
            "path": "bash"
        },
        "bash": {
            "icon": "terminal-bash",
            "path": "bash"
        },
        "fish": {
            "path": "fish"
        },
        "pwsh": {
            "icon": "terminal-powershell",
            "path": "pwsh"
        },
        "tmux": {
            "icon": "terminal-tmux",
            "path": "tmux"
        },
        "zsh": {
            "path": "zsh"
        }
    },
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.tabs.enabled": true,
    "window.autoDetectColorScheme": true,
    "window.dialogStyle": "custom",
    "window.menuStyle": "custom",
    "window.titleBarStyle": "native",
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "hidden",
"workbench.colorCustomizations": {
        // Base Contrast & System Layout
        "focusBorder": "#007f7f",
        "foreground": "#e0e0e0",
        "selection.background": "#007f7f55",
        "errorForeground": "#ff5555",
        "descriptionForeground": "#aaaaaa",
        "widget.shadow": "#00000088",
        "widget.border": "#007f7f44",

        // Code Editor Window
        "editor.background": "#121212",
        "editor.foreground": "#ffffff",
        "editor.lineHighlightBackground": "#007f7f13",
        "editor.lineHighlightBorder": "#007f7f44",
        "editorLineNumber.foreground": "#555555",
        "editorLineNumber.activeForeground": "#007f7f",
        "editorCursor.foreground": "#007f7f",

        // Text Selection & Search Highlights
        "editor.selectionBackground": "#007f7f44",
        "editor.selectionHighlightBackground": "#007f7f22",
        "editor.findMatchBackground": "#007f7f77",
        "editor.findMatchHighlightBackground": "#007f7f33",
        "editor.wordHighlightBackground": "#007f7f22",
        "editor.wordHighlightStrongBackground": "#007f7f44",

        // Activity Bar (Far Left Panel)
        "activityBar.background": "#161616",
        "activityBar.dropBackground": "#007f7f33",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#ffffff66",
        "activityBar.border": "#007f7f33",
        "activityBarBadge.background": "#007f7f",
        "activityBarBadge.foreground": "#101010",

        // Side Bar (Explorer, Search, Source Control)
        "sideBar.background": "#161616",
        "sideBar.foreground": "#e0e0e0",
        "sideBar.border": "#007f7f22",
        "sideBar.dropBackground": "#007f7f33",
        "sideBarTitle.foreground": "#ffffff",
        "sideBarSectionHeader.background": "#1e1e1e",
        "sideBarSectionHeader.foreground": "#ffffff",
        "sideBarSectionHeader.border": "#007f7f22",

        // File Trees & Dropdown Lists
        "list.activeSelectionBackground": "#007f7f33",
        "list.activeSelectionForeground": "#ffffff",
        "list.focusAndSelectionBackground": "#007f7f44",
        "list.focusForeground": "#ffffff",
        "list.focusOutline": "#007f7f",
        "list.highlightForeground": "#007f7f",
        "list.hoverBackground": "#007f7f15",
        "list.hoverForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#ffffff15",
        "list.inactiveSelectionForeground": "#ffffff",
        "list.inactiveFocusBackground": "#ffffff10",
        "list.invalidItemForeground": "#ff5555",

        // Editor Tabs & Tab Bar Layout (Top of Editor)
        "editorGroupHeader.noTabsBackground": "#161616",
        "editorGroupHeader.tabsBackground": "#161616",
        "editorGroupHeader.tabsBorder": "#007f7f22",
        "tab.activeBackground": "#121212",
        "tab.activeForeground": "#ffffff",
        "tab.activeBorder": "#007f7f",
        "tab.activeBorderTop": "#007f7f",
        "tab.unfocusedActiveBorder": "#007f7f88",
        "tab.inactiveBackground": "#1a1a1a",
        "tab.inactiveForeground": "#ffffff55",
        "tab.hoverBackground": "#007f7f15",
        "tab.hoverForeground": "#ffffff",
        "tab.border": "#121212",

        // Bottom Panel Layout (Terminal, Output, Debug Console Tabs)
        "panel.background": "#121212",
        "panel.border": "#007f7f44",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.activeBorder": "#007f7f",
        "panelTitle.inactiveForeground": "#ffffff55",
        "panelInput.background": "#1e1e1e",

        // Bottom Status Bar
        "statusBar.background": "#161616",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#007f7f22",
        "statusBar.debuggingBackground": "#cc3333",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBar.noFolderBackground": "#161616",
        "statusBar.noFolderForeground": "#ffffff",
        "statusBarItem.remoteBackground": "#007f7f",
        "statusBarItem.remoteForeground": "#101010",
        "statusBarItem.hoverBackground": "#007f7f33",
        "statusBarItem.activeBackground": "#007f7f55",

        // Title Bar (Top Window Frame)
        "titleBar.activeBackground": "#161616",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#161616",
        "titleBar.inactiveForeground": "#ffffff55",
        "titleBar.border": "#007f7f22",

        // Interactive Buttons (Source Control & Form Targets)
        "button.background": "#009aa2",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#007d83",
        "button.separator": "#ffffff33",

        // Input Fields (Fuzzy Finder, Search Inputs)
        "input.background": "#1e1e1e",
        "input.foreground": "#ffffff",
        "input.border": "#007f7f44",
        "input.placeholderForeground": "#ffffff55",
        "inputOption.activeBorder": "#007f7f",
        "inputValidation.errorBackground": "#551111",
        "inputValidation.errorBorder": "#ff5555",

        // Quick Pick Palette (Command Palette Dropdown)
        "pickerGroup.border": "#007f7f44",
        "pickerGroup.foreground": "#007f7f",
        "quickInput.background": "#161616",
        "quickInput.foreground": "#ffffff",
        "quickInputList.focusBackground": "#007f7f33",
        "quickInputList.focusForeground": "#ffffff",
        "quickInputList.focusIconForeground": "#007f7f",

        // Integrated Terminal Panels
        "terminal.background": "#121212",
        "terminal.foreground": "#ffffff",
        "terminalCursor.foreground": "#007f7f",
        "terminalCursor.background": "#121212",
        "terminal.border": "#007f7f22",
        "terminal.selectionBackground": "#007f7f44",

        // Scrollbars & Split View Sashes
        "scrollbarSlider.background": "#ffffff15",
        "scrollbarSlider.hoverBackground": "#007f7f33",
        "scrollbarSlider.activeBackground": "#007f7f55",
        "sash.hoverBorder": "#007f7f",

        // Breadcrumbs Navigation (Top of Editor)
        "breadcrumb.background": "#121212",
        "breadcrumb.foreground": "#ffffff88",
        "breadcrumb.focusForeground": "#ffffff",
        "breadcrumb.activeSelectionForeground": "#007f7f",

        // Notification Popups
        "notificationCenterHeader.background": "#161616",
        "notificationCenterHeader.foreground": "#ffffff",
        "notifications.background": "#161616",
        "notifications.foreground": "#ffffff",
        "notifications.border": "#007f7f44"
},

    "workbench.editor.centeredLayoutFixedWidth": true,
    "workbench.editor.closeEmptyGroups": false,
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.showTabs": "none",
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "workbench.experimental.modernUI": true,
    "workbench.experimental.share.enabled": true,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.list.smoothScrolling": true,
    "workbench.productIconTheme": "material-product-icons",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tree.renderIndentGuides": "always",
    "ruff.path": [
        "/usr/bin/ruff"
    ],
    "ruff.trace.server": "verbose",
    "window.customTitleBarVisibility": "never",
    "terminal.integrated.enableVisualBell": true,
    "editor.fontSize": 13,
    "chat.editor.fontSize": 13,
    "chat.fontSize": 13,
    "debug.console.fontSize": 13,
    "scm.inputFontSize": 13,
    "terminal.integrated.fontSize": 13,
    "markdown.preview.fontSize": 13,
    "python.languageServer": "Default"
}
