#!/usr/bin/env bash

###############################################################################
# Configuration
###############################################################################

WORKTREE="${WORKTREE:-master}"
SRC_DIR="${SRC_DIR:-$HOME/ws/i/emacs/worktrees/$WORKTREE}"
BUILD_DIR="${BUILD_DIR:-$HOME/ws/i/emacs/builds/$WORKTREE}"

# Keep the actual installed application in a stable prefix, like Emacs+.
INSTALL_PREFIX="${INSTALL_PREFIX:-$HOME/.local}"

# Native compilation mode passed to --with-native-compilation.
#   aot      - compile all of Emacs' Lisp at build time (default, slowest,
#              most exposed to libgccjit/GCC crashes during the build)
#   deferred - compile lazily the first time each file loads at runtime
#   no       - disable native compilation entirely
NATIVE_COMP="${NATIVE_COMP:-aot}"

# Remotes used to keep the worktree in sync before building.
#   origin          - your own bare mirror; receives the updated branch
#   upstream        - canonical upstream (e.g. git.savannah.gnu.org)
#   upstream-mirror - fallback used only if upstream is unreachable
REMOTE_ORIGIN="${REMOTE_ORIGIN:-origin}"
REMOTE_UPSTREAM="${REMOTE_UPSTREAM:-upstream}"
REMOTE_UPSTREAM_MIRROR="${REMOTE_UPSTREAM_MIRROR:-upstream-mirror}"

CLEAN_BUILD=false
UNINSTALL=false
STATUS=false

WORKTREE_OPTION_SET=false

###############################################################################
# Helpers
###############################################################################

log() {
    printf '\n==> %s\n' "$*"
}

warn() {
    printf 'Warning: %s\n' "$*" >&2
}

error() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        error "Required command not found: $1"
}

cleanup_on_error() {
    local exit_code=$?

    if ((exit_code != 0)); then
        printf '\n❌ Build failed with exit code %d.\n' "$exit_code" >&2
        printf '   Source: %s\n' "$SRC_DIR" >&2
        printf '   Build:  %s\n' "$BUILD_DIR" >&2
    fi
}

trap cleanup_on_error EXIT

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Build and install Emacs from:
  $SRC_DIR

Options:
  --stable           Use the stable worktree
  --master           Use the master worktree (default)
  --worktree NAME    Use a custom worktree
  -c, --clean        Remove the existing build directory before configuring
  -u, --uninstall    Remove the installed Emacs integration
  -s, --status       Show Emacs installation/service status
  -h, --help         Show this help

Environment:
  WORKTREE           Worktree name
  SRC_DIR            Override source directory
  BUILD_DIR          Override build directory
  INSTALL_PREFIX     Installation prefix (default: ~/.local)
  NATIVE_COMP        aot (default), deferred, or no
  REMOTE_ORIGIN      Your bare mirror remote name (default: origin)
  REMOTE_UPSTREAM    Canonical upstream remote name (default: upstream)
  REMOTE_UPSTREAM_MIRROR
                     Fallback remote if upstream is unreachable
                     (default: upstream-mirror)

Examples:
  $0
  $0 --stable
  $0 --worktree emacs-32
  $0 --clean
  $0 --status
  $0 --uninstall
EOF
}

###############################################################################
# Package lists
###############################################################################

# These are intentionally close to the dependencies used by Emacs+.
#
# Homebrew's superenv normally handles much of this automatically. Since this
# script builds outside Homebrew, we explicitly install the tools required by
# the Emacs build.

brew_build_dependencies=(
    make
    autoconf
    gnu-sed
    gnu-tar
    grep
    coreutils
    pkg-config
    texinfo
    xz
    m4
    sqlite
    gnutls
    librsvg
    little-cms2
    tree-sitter
    webp
    libgccjit
    gcc
    gmp
    libjpeg
    zlib
    texlive
    jq
)

arch_build_dependencies=(
    texinfo
    gnutls
    librsvg
    libxml2
    libwebp
    lcms2
    tree-sitter
    libgccjit
    texlive
    pkgconf
    jansson
    cairo
    harfbuzz
    sqlite
    alsa-lib
)

###############################################################################
# Argument parsing
###############################################################################

while (($# > 0)); do
    case "$1" in
        --stable)
            [[ "$WORKTREE_OPTION_SET" == false ]] ||
                error "--stable, --master, and --worktree cannot be used together"

            WORKTREE_OPTION_SET=true
            WORKTREE="stable"
            SRC_DIR="$HOME/ws/i/emacs/worktrees/stable"
            BUILD_DIR="$HOME/ws/i/emacs/builds/stable"
            ;;

        --master)
            [[ "$WORKTREE_OPTION_SET" == false ]] ||
                error "--stable, --master, and --worktree cannot be used together"

            WORKTREE_OPTION_SET=true
            WORKTREE="master"
            SRC_DIR="$HOME/ws/i/emacs/worktrees/master"
            BUILD_DIR="$HOME/ws/i/emacs/builds/master"
            ;;

        --worktree)
            [[ "$WORKTREE_OPTION_SET" == false ]] ||
                error "--stable, --master, and --worktree cannot be used together"

            shift
            (($# > 0)) || error "--worktree requires a name"

            WORKTREE_OPTION_SET=true
            WORKTREE="$1"
            SRC_DIR="$HOME/ws/i/emacs/worktrees/$WORKTREE"
            BUILD_DIR="$HOME/ws/i/emacs/builds/$WORKTREE"
            ;;

        -c|--clean)
            CLEAN_BUILD=true
            ;;

        -u|--uninstall)
            UNINSTALL=true
            ;;

        -s|--status)
            STATUS=true
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        *)
            error "Unknown parameter: $1"
            ;;
    esac

    shift
done

if [[ "$UNINSTALL" == true && "$STATUS" == true ]]; then
    error "--uninstall and --status cannot be used together"
fi

###############################################################################
# OS detection
###############################################################################

OS="$(uname -s)"

case "$OS" in
    Darwin)
        PLATFORM="macOS"
        ;;

    Linux)
        PLATFORM="Linux"
        ;;

    *)
        error "Unsupported operating system: $OS"
        ;;
esac

###############################################################################
# Common build validation
###############################################################################

validate_source_tree() {
    log "Checking Emacs source tree: $SRC_DIR"

    [[ -d "$SRC_DIR" ]] ||
        error "Emacs source directory not found: $SRC_DIR"

    [[ -f "$SRC_DIR/configure.ac" ]] ||
        error "$SRC_DIR does not appear to be an Emacs source tree"
}

prepare_build_directory() {
    if [[ "$CLEAN_BUILD" == true ]]; then
        if [[ -f "$BUILD_DIR/Makefile" ]]; then
            log "Running distclean"
            if [[ "$PLATFORM" == "macOS" ]]; then
                gmake -C "$BUILD_DIR" distclean || true
            else
                make -C "$BUILD_DIR" distclean || true
            fi
        fi

        log "Removing build directory"
        rm -rf "$BUILD_DIR"
    fi

    mkdir -p "$BUILD_DIR"
}

###############################################################################
# Worktree sync
###############################################################################

# Fetch a single remote if it's configured; warn (don't fail the whole
# sync) if it isn't, since upstream-mirror in particular may not exist
# in every checkout.
fetch_remote_if_configured() {
    local remote="$1"

    if ! git -C "$SRC_DIR" remote get-url "$remote" >/dev/null 2>&1; then
        warn "Remote not configured: $remote"
        return 1
    fi

    log "Fetching $remote"
    git -C "$SRC_DIR" fetch --prune "$remote"
}

fetch_all_remotes() {
    fetch_remote_if_configured "$REMOTE_ORIGIN" || true
    fetch_remote_if_configured "$REMOTE_UPSTREAM" || true
    fetch_remote_if_configured "$REMOTE_UPSTREAM_MIRROR" || true
}

# Prints the remote to build the worktree from: upstream if reachable,
# otherwise upstream-mirror.
select_upstream_remote() {
    if git -C "$SRC_DIR" remote get-url "$REMOTE_UPSTREAM" >/dev/null 2>&1 &&
        git -C "$SRC_DIR" ls-remote "$REMOTE_UPSTREAM" >/dev/null 2>&1
    then
        printf '%s\n' "$REMOTE_UPSTREAM"
        return 0
    fi

    warn "$REMOTE_UPSTREAM is unreachable; falling back to $REMOTE_UPSTREAM_MIRROR"

    if git -C "$SRC_DIR" remote get-url "$REMOTE_UPSTREAM_MIRROR" >/dev/null 2>&1 &&
        git -C "$SRC_DIR" ls-remote "$REMOTE_UPSTREAM_MIRROR" >/dev/null 2>&1
    then
        printf '%s\n' "$REMOTE_UPSTREAM_MIRROR"
        return 0
    fi

    error "Neither $REMOTE_UPSTREAM nor $REMOTE_UPSTREAM_MIRROR is reachable"
}

# Prints the name of the highest-versioned emacs-NN release branch
# (e.g. emacs-30) available on the given remote.
latest_stable_branch() {
    local remote="$1"

    git -C "$SRC_DIR" ls-remote --heads "$remote" 'emacs-[0-9]*' |
        awk '{print $2}' |
        sed 's#refs/heads/##' |
        grep -E '^emacs-[0-9]+$' |
        sort -t- -k2 -n |
        tail -n1
}

sync_worktree_with_upstream() {
    require_command git

    log "Syncing worktree '$WORKTREE' with upstream"

    fetch_all_remotes

    local remote
    remote="$(select_upstream_remote)"

    local target_branch
    case "$WORKTREE" in
        master)
            target_branch="master"
            ;;
        stable)
            target_branch="$(latest_stable_branch "$remote")"
            [[ -n "$target_branch" ]] ||
                error "Could not determine latest stable branch on $remote"
            log "Latest stable branch on $remote: $target_branch"
            ;;
        *)
            # Custom worktree name: assume it names a branch directly.
            target_branch="$WORKTREE"
            ;;
    esac

    log "Updating worktree to $remote/$target_branch"

    git -C "$SRC_DIR" checkout -B "$WORKTREE" "$remote/$target_branch" ||
        error "Failed to update worktree to $remote/$target_branch"

    if git -C "$SRC_DIR" remote get-url "$REMOTE_ORIGIN" >/dev/null 2>&1; then
        log "Pushing updated worktree to $REMOTE_ORIGIN"
        git -C "$SRC_DIR" push --force "$REMOTE_ORIGIN" "$WORKTREE:$WORKTREE" ||
            warn "Failed to push updated worktree to $REMOTE_ORIGIN"
    else
        warn "Remote not configured: $REMOTE_ORIGIN (skipping push)"
    fi
}

###############################################################################
# macOS
###############################################################################

macos_brew_prefix() {
    brew --prefix
}

macos_gcc_version() {
    local version

    version="$(
        brew info --json=v2 gcc 2>/dev/null |
            jq -r '.formulae[0].installed[0].version // empty' |
            head -n 1
    )"

    if [[ -n "$version" ]]; then
        printf '%s\n' "$version"
        return
    fi

    # Fallback.
    local gcc_prefix
    gcc_prefix="$(brew --prefix gcc)"

    find "$gcc_prefix/lib/gcc" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -exec basename {} \; |
        sort -V |
        tail -n 1
}

macos_find_emutls_dir() {
    local gcc_prefix="$1"
    local gcc_major="$2"

    local gcc_bin="$gcc_prefix/bin/gcc-$gcc_major"
    local emutls_path=""

    if [[ -x "$gcc_bin" ]]; then
        emutls_path="$(
            "$gcc_bin" -print-file-name=libemutls_w.a 2>/dev/null || true
        )"
    fi

    if [[ "$emutls_path" == */* && -f "$emutls_path" ]]; then
        dirname "$emutls_path"
        return 0
    fi

    # Fallback for unusual Homebrew GCC layouts.
    local gcc_lib
    gcc_lib="$(brew --prefix)/lib/gcc/$gcc_major"

    if [[ -f "$gcc_lib/libemutls_w.a" ]]; then
        printf '%s\n' "$gcc_lib"
        return 0
    fi

    return 1
}

###############################################################################
# macOS Emacs Client.app
###############################################################################

create_emacs_client_app() {
    local icons_dir="$1"
    local prefix="$2"

    local client_app="$BUILD_DIR/nextstep/Emacs Client.app"
    local client_script="$BUILD_DIR/emacs-client.applescript"
    local emacsclient="$prefix/bin/emacsclient"

    log "Creating Emacs Client.app"

    rm -rf "$client_app"

    cat > "$client_script" <<EOF
-- Emacs Client AppleScript Application
-- Handles opening files from Finder, drag-and-drop, and launching from Spotlight/Dock

on open theDropped
    repeat with oneDrop in theDropped
        set dropPath to quoted form of POSIX path of oneDrop

        try
            do shell script "$emacsclient -c -a '' -n " & dropPath
        end try
    end repeat

    try
        do shell script "open -a 'Emacs'"
    end try
end open

on run
    try
        do shell script "$emacsclient -c -a '' -n"
    end try

    try
        do shell script "open -a 'Emacs'"
    end try
end run

on open location this_URL
    try
        do shell script "$emacsclient -n " & quoted form of this_URL
    end try

    try
        do shell script "open -a 'Emacs'"
    end try
end open location
EOF

    osacompile -o "$client_app" "$client_script"
    rm -f "$client_script"

    local plist="$client_app/Contents/Info.plist"

    /usr/libexec/PlistBuddy \
        -c "Set :CFBundleIdentifier string org.gnu.EmacsClient" \
        "$plist" 2>/dev/null ||
    /usr/libexec/PlistBuddy \
        -c "Add :CFBundleIdentifier string org.gnu.EmacsClient" \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c "Set :CFBundleName string 'Emacs Client'" \
        "$plist" 2>/dev/null ||
    /usr/libexec/PlistBuddy \
        -c "Add :CFBundleName string 'Emacs Client'" \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c "Set :CFBundleDisplayName string 'Emacs Client'" \
        "$plist" 2>/dev/null ||
    /usr/libexec/PlistBuddy \
        -c "Add :CFBundleDisplayName string 'Emacs Client'" \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c "Set :LSApplicationCategoryType string public.app-category.productivity" \
        "$plist" 2>/dev/null ||
    /usr/libexec/PlistBuddy \
        -c "Add :LSApplicationCategoryType string public.app-category.productivity" \
        "$plist"

    # Remove generated AppleScript icon metadata. Emacs+ similarly fixes the
    # client bundle so macOS does not use stale Assets.car/droplet resources.
    rm -f \
        "$client_app/Contents/Resources/droplet.icns" \
        "$client_app/Contents/Resources/droplet.rsrc" \
        "$client_app/Contents/Resources/Assets.car"

    if [[ -f "$icons_dir/Emacs.icns" ]]; then
        cp \
            "$icons_dir/Emacs.icns" \
            "$client_app/Contents/Resources/applet.icns"
    fi

    /usr/libexec/PlistBuddy \
        -c 'Delete :CFBundleIconFile' \
        "$plist" 2>/dev/null || true

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleIconFile string applet' \
        "$plist"

    # Document types.
    /usr/libexec/PlistBuddy \
        -c 'Delete :CFBundleDocumentTypes' \
        "$plist" 2>/dev/null || true

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes array' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0 dict' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0:CFBundleTypeRole string Editor' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0:CFBundleTypeName string Text Document' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes array' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:0 string public.text' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:1 string public.plain-text' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:2 string public.source-code' \
        "$plist"

    # org-protocol.
    /usr/libexec/PlistBuddy \
        -c 'Delete :CFBundleURLTypes' \
        "$plist" 2>/dev/null || true

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleURLTypes array' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleURLTypes:0 dict' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleURLTypes:0:CFBundleURLName string Org Protocol' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes array' \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string org-protocol' \
        "$plist"

    rm -f \
        "$client_app/Contents/Resources/droplet.icns" \
        "$client_app/Contents/Resources/droplet.rsrc" \
        "$client_app/Contents/Resources/Assets.car"

    if [[ -f "$icons_dir/Emacs.icns" ]]; then
        cp "$icons_dir/Emacs.icns" \
            "$client_app/Contents/Resources/applet.icns"
    fi
}

###############################################################################
# macOS icon
###############################################################################

apply_png_icon_macos() {
    local app_dir="$1"

    local icon_dir
    icon_dir="$(dirname "$(dirname "$SRC_DIR")")/resources/icons"

    local png_file=""

    if [[ -d "$icon_dir" ]]; then
        png_file="$(
            find "$icon_dir" \
                -maxdepth 1 \
                -type f \
                -name '*.png' \
                -print |
                sort |
                head -n 1
        )"
    fi

    [[ -n "$png_file" ]] || return 0
    [[ -f "$png_file" ]] || return 0

    require_command sips
    require_command iconutil

    log "Creating macOS icon from $png_file"

    local iconset_dir="$BUILD_DIR/Emacs.iconset"

    rm -rf "$iconset_dir"
    mkdir -p "$iconset_dir"

    sips -z 16 16 \
        "$png_file" \
        --out "$iconset_dir/icon_16x16.png" >/dev/null

    sips -z 32 32 \
        "$png_file" \
        --out "$iconset_dir/icon_16x16@2x.png" >/dev/null

    sips -z 32 32 \
        "$png_file" \
        --out "$iconset_dir/icon_32x32.png" >/dev/null

    sips -z 64 64 \
        "$png_file" \
        --out "$iconset_dir/icon_32x32@2x.png" >/dev/null

    sips -z 128 128 \
        "$png_file" \
        --out "$iconset_dir/icon_128x128.png" >/dev/null

    sips -z 256 256 \
        "$png_file" \
        --out "$iconset_dir/icon_128x128@2x.png" >/dev/null

    sips -z 256 256 \
        "$png_file" \
        --out "$iconset_dir/icon_256x256.png" >/dev/null

    sips -z 512 512 \
        "$png_file" \
        --out "$iconset_dir/icon_256x256@2x.png" >/dev/null

    sips -z 512 512 \
        "$png_file" \
        --out "$iconset_dir/icon_512x512.png" >/dev/null

    sips -z 1024 1024 \
        "$png_file" \
        --out "$iconset_dir/icon_512x512@2x.png" >/dev/null

    iconutil \
        -c icns \
        "$iconset_dir" \
        -o "$app_dir/Contents/Resources/Emacs.icns"

    rm -rf "$iconset_dir"
}

###############################################################################
# macOS emacs wrapper
###############################################################################

create_emacs_bin_proxy() {
    local prefix="$1"
    local bin_file="$prefix/bin/emacs"

    log "Creating Emacs binary wrapper"

    mkdir -p "$prefix/bin"

    cat > "$bin_file" <<EOF
#!/usr/bin/env bash

for app in \
    "$prefix/Emacs.app" \
    "/Applications/Emacs.app" \
    "\$HOME/Applications/Emacs.app"
do
    if [[ -x "\$app/Contents/MacOS/Emacs" ]]; then
        exec "\$app/Contents/MacOS/Emacs" "\$@"
    fi
done

echo "Error: Emacs.app not found in:" >&2
echo "  $prefix/Emacs.app" >&2
echo "  /Applications/Emacs.app" >&2
echo "  \$HOME/Applications/Emacs.app" >&2

exit 1
EOF

    chmod +x "$bin_file"
}

###############################################################################
# macOS LSEnvironment
###############################################################################

inject_macos_environment() {
    local app_dir="$1"
    local brew_prefix="$2"
    local library_path="$3"

    local plist="$app_dir/Contents/Info.plist"

    [[ -f "$plist" ]] || error "Missing Info.plist: $plist"

    log "Injecting PATH and LIBRARY_PATH into Emacs.app"

    /usr/libexec/PlistBuddy \
        -c 'Delete :LSEnvironment' \
        "$plist" 2>/dev/null || true

    /usr/libexec/PlistBuddy \
        -c 'Add :LSEnvironment dict' \
        "$plist"

    # Follow Emacs+ behavior: inject the actual shell PATH.
    /usr/libexec/PlistBuddy \
        -c "Add :LSEnvironment:PATH string $PATH" \
        "$plist"

    /usr/libexec/PlistBuddy \
        -c "Add :LSEnvironment:LIBRARY_PATH string $library_path" \
        "$plist"

    # Do NOT inject CC.
    #
    # Emacs+ explicitly removed CC injection because LSEnvironment is inherited
    # by every subprocess launched from GUI Emacs.
}

###############################################################################
# macOS post-install fixups
###############################################################################

# For --with-ns builds, 'gmake install' does not reliably place a working
# emacsclient at $install_prefix/bin. Copy the one built in lib-src
# directly if that happened.
ensure_emacsclient_installed() {
    local install_prefix="$1"
    local emacsclient_path="$install_prefix/bin/emacsclient"

    if [[ -x "$emacsclient_path" ]]; then
        return 0
    fi

    warn "emacsclient missing from $install_prefix/bin after 'gmake install'; copying it directly"

    local built_emacsclient="$BUILD_DIR/lib-src/emacsclient"

    [[ -x "$built_emacsclient" ]] ||
        error "Could not find built emacsclient: $built_emacsclient"

    mkdir -p "$install_prefix/bin"
    cp "$built_emacsclient" "$emacsclient_path"
    chmod +x "$emacsclient_path"
}

# The native-comp eln loader looks for compiled Lisp relative to the
# installed binary's own directory, at "$bindir/../native-lisp" (visible
# in native-comp load errors as "execdir $install_prefix/bin/"). 'gmake
# install' instead places eln files under lib/emacs/<version>/native-lisp,
# so create a matching symlink where Emacs actually looks.
link_native_lisp_for_bindir_lookup() {
    local install_prefix="$1"

    local native_lisp_src
    native_lisp_src="$(
        find "$install_prefix/lib/emacs" \
            -mindepth 2 \
            -maxdepth 2 \
            -type d \
            -name native-lisp \
            2>/dev/null |
            head -n 1
    )"

    if [[ -z "$native_lisp_src" ]]; then
        warn "Could not find an installed native-lisp directory under $install_prefix/lib/emacs"
        return 0
    fi

    log "Linking $install_prefix/native-lisp -> $native_lisp_src"

    rm -rf "$install_prefix/native-lisp"
    ln -s "$native_lisp_src" "$install_prefix/native-lisp"
}

###############################################################################
# macOS installation
###############################################################################

install_macos() {
    require_command brew
    require_command gmake
    require_command autoconf
    require_command jq
    require_command osacompile
    require_command codesign

    [[ -x /usr/libexec/PlistBuddy ]] ||
        error "Required command not found: /usr/libexec/PlistBuddy"

    validate_source_tree

    sync_worktree_with_upstream

    log "Installing Homebrew build dependencies"

    brew install "${brew_build_dependencies[@]}"

    prepare_build_directory

    local brew_prefix
    brew_prefix="$(macos_brew_prefix)"

    local install_prefix="$INSTALL_PREFIX"

    mkdir -p \
        "$install_prefix/bin" \
        "$install_prefix/share/emacs/site-lisp" \
        "$install_prefix/share/info/emacs"

    local sqlite_prefix
    sqlite_prefix="$(brew --prefix sqlite)"
    local gcc_prefix
    gcc_prefix="$(brew --prefix gcc)"

    local libgccjit_prefix
    libgccjit_prefix="$(brew --prefix libgccjit)"

    local tree_sitter_prefix
    if brew list --formula tree-sitter@0.25 >/dev/null 2>&1; then
        tree_sitter_prefix="$(brew --prefix tree-sitter@0.25)"
    else
        tree_sitter_prefix="$(brew --prefix tree-sitter)"
    fi

    local gcc_version
    gcc_version="$(macos_gcc_version)"

    [[ -n "$gcc_version" ]] ||
        error "Could not determine installed Homebrew GCC version"

    local gcc_major="${gcc_version%%.*}"
    local gcc_lib="$brew_prefix/lib/gcc/$gcc_major"

    [[ -d "$gcc_lib" ]] ||
        warn "GCC library directory does not exist: $gcc_lib"

    # Emacs+ uses the GCC driver to find libemutls_w.a rather than guessing
    # from the first GCC directory found.
    local emutls_dir=""
    emutls_dir="$(
        macos_find_emutls_dir "$gcc_prefix" "$gcc_major" 2>/dev/null || true
    )"

    if [[ -z "$emutls_dir" ]]; then
        warn "Could not locate libemutls_w.a"
        warn "Native compilation from GUI Emacs may fail to link native modules."
    fi

    local native_comp_flag
    case "$NATIVE_COMP" in
        aot)      native_comp_flag="--with-native-compilation=aot" ;;
        deferred) native_comp_flag="--with-native-compilation" ;;
        no)       native_comp_flag="--without-native-compilation" ;;
        *)        error "Invalid NATIVE_COMP value: $NATIVE_COMP (use aot, deferred, or no)" ;;
    esac

    local cflags=(
        "-DFD_SETSIZE=10000"
        "-DDARWIN_UNLIMITED_SELECT"
        "-I$sqlite_prefix/include"
        "-I$gcc_prefix/include"
        "-I$libgccjit_prefix/include"
    )

    local ldflags=(
        "-L$sqlite_prefix/lib"
        "-L$gcc_lib"
        "-Wl,-rpath,$gcc_lib"
    )

    # Keep LIBRARY_PATH separate from LDFLAGS.
    #
    # libgccjit needs libemutls_w.a when native-compiling from GUI-launched
    # Emacs. The libgccjit library directory is included as well.
    local library_path_entries=()

    [[ -n "$emutls_dir" ]] &&
        library_path_entries+=("$emutls_dir")

    library_path_entries+=(
        "$brew_prefix/lib/gcc/current"
        "$libgccjit_prefix/lib/gcc/current"
        "$brew_prefix/lib"
    )

    local library_path
    library_path="$(
        IFS=:
        printf '%s' "${library_path_entries[*]}"
    )"

    # Do not export an artificial PATH. Homebrew's tools are made available
    # explicitly for configure/build, while the user's real PATH is retained
    # for LSEnvironment injection.
    local build_path
    build_path="$(
        printf '%s' \
            "$brew_prefix/opt/make/libexec/gnubin:$brew_prefix/bin:$PATH"
    )"

    log "Preparing configure environment"

    export PATH="$build_path"

    cd "$SRC_DIR"

    log "Running autogen.sh"
    ./autogen.sh

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    log "Configuring Emacs"

    "$SRC_DIR/configure" \
        --prefix="$install_prefix" \
        --disable-dependency-tracking \
        --disable-silent-rules \
        --enable-locallisppath="$install_prefix/share/emacs/site-lisp" \
        --infodir="$install_prefix/share/info/emacs" \
        "$native_comp_flag" \
        --with-ns \
        --disable-ns-self-contained \
        --with-modules \
        --with-xml2 \
        --with-gnutls \
        --with-rsvg \
        --with-webp \
        --with-tree-sitter \
        --without-compress-install \
        "CFLAGS=${cflags[*]}"

    # Match Emacs+'s explicit linker configuration.
    export LDFLAGS="${ldflags[*]}"
    export LIBRARY_PATH="$library_path"

    log "Building Emacs using $(sysctl -n hw.ncpu) CPU cores"

    # Deeply recursive batch operations during the build (wisent/bovine
    # grammar table generation, leim-list.el generation via quail) can
    # overflow the default 8 MiB stack and crash bootstrap-emacs with a
    # segfault/abort rather than a clean error. This is a long-standing
    # macOS issue documented in Emacs's own etc/PROBLEMS file. Raise the
    # soft limit to the hard limit before building.
    local stack_hard_limit
    stack_hard_limit="$(ulimit -Hs)"
    ulimit -s "$stack_hard_limit" 2>/dev/null ||
        warn "Could not raise stack size limit (currently $(ulimit -s)); grammar/leim generation may segfault"

    gmake -j"$(sysctl -n hw.ncpu)"

    log "Installing Emacs into $install_prefix"

    gmake install

    ensure_emacsclient_installed "$install_prefix"
    link_native_lisp_for_bindir_lookup "$install_prefix"

    local build_app="$BUILD_DIR/nextstep/Emacs.app"
    local build_client="$BUILD_DIR/nextstep/Emacs Client.app"

    [[ -d "$build_app" ]] ||
        error "Built Emacs.app not found: $build_app"

    # The important Emacs+ behavior:
    #
    #   build/nextstep/Emacs.app
    #              ↓
    #       INSTALL_PREFIX/Emacs.app
    #
    # Do not make ~/Applications the canonical installation.
    log "Installing Emacs.app into $install_prefix"

    rm -rf "$install_prefix/Emacs.app"
    cp -R "$build_app" "$install_prefix/Emacs.app"

    local installed_app="$install_prefix/Emacs.app"

    # Remove stale resources that can interfere with the application icon on
    # newer macOS versions.
    rm -f \
        "$installed_app/Contents/Resources/Assets.car" \
        "$installed_app/Contents/Resources/droplet.icns" \
        "$installed_app/Contents/Resources/droplet.rsrc"

    apply_png_icon_macos "$installed_app"

    # Create Emacs Client.app from the same build.
    create_emacs_client_app \
        "$installed_app/Contents/Resources" \
        "$install_prefix"

    log "Installing Emacs Client.app into $install_prefix"

    rm -rf "$install_prefix/Emacs Client.app"

    if [[ -d "$build_client" ]]; then
        cp -R "$build_client" "$install_prefix/Emacs Client.app"
    else
        error "Emacs Client.app was not created"
    fi

    # Inject environment after the final application has been copied.
    inject_macos_environment \
        "$installed_app" \
        "$brew_prefix" \
        "$library_path"

    # Re-create wrapper after installation.
    create_emacs_bin_proxy "$install_prefix"

    # Emacs+ re-signs both bundles after modifying them.
    log "Re-signing Emacs.app"

    codesign \
        --force \
        --deep \
        --sign - \
        "$installed_app"

    log "Re-signing Emacs Client.app"

    codesign \
        --force \
        --deep \
        --sign - \
        "$install_prefix/Emacs Client.app"

    # Optional convenience copies.
    #
    # The prefix remains canonical, but these make Spotlight/Finder integration
    # convenient, matching Emacs+'s documented behavior.
    log "Installing application copies into ~/Applications"

    mkdir -p "$HOME/Applications"

    rm -rf "$HOME/Applications/Emacs.app"
    cp -R \
        "$installed_app" \
        "$HOME/Applications/Emacs.app"

    rm -rf "$HOME/Applications/Emacs Client.app"
    cp -R \
        "$install_prefix/Emacs Client.app" \
        "$HOME/Applications/Emacs Client.app"

    echo
    echo "--------------------------------------------------"
    echo "✅ macOS Emacs build complete"
    echo
    echo "   Worktree:     $WORKTREE"
    echo "   Build:        $BUILD_DIR"
    echo "   Prefix:       $install_prefix"
    echo "   Emacs.app:    $install_prefix/Emacs.app"
    echo "   Client.app:   $install_prefix/Emacs Client.app"
    echo
    echo "   Finder copy:  $HOME/Applications/Emacs.app"
    echo "   Client copy:  $HOME/Applications/Emacs Client.app"
    echo
    echo "   Native Comp:  $NATIVE_COMP"
    echo "   Tree-Sitter:  yes"
    echo "   GnuTLS:       yes"
    echo "   RSVG:         yes"
    echo "   WebP:         yes"
    echo "   Modules:      yes"
    echo "--------------------------------------------------"
}

###############################################################################
# macOS uninstall
###############################################################################

uninstall_macos() {
    require_command launchctl

    local uid
    uid="$(id -u)"

    local plist_file="$HOME/Library/LaunchAgents/org.gnu.Emacs.plist"

    if [[ -f "$plist_file" ]]; then
        log "Stopping Emacs launchd service"

        launchctl bootout \
            "gui/$uid" \
            "$plist_file" \
            2>/dev/null || true

        rm -f "$plist_file"
    fi

    local paths=(
        "$INSTALL_PREFIX/Emacs.app"
        "$INSTALL_PREFIX/Emacs Client.app"
        "$INSTALL_PREFIX/bin/emacs"
        "$HOME/Applications/Emacs.app"
        "$HOME/Applications/Emacs Client.app"
    )

    for path in "${paths[@]}"; do
        if [[ -e "$path" || -L "$path" ]]; then
            log "Removing $path"
            rm -rf "$path"
        fi
    done

    echo "✅ macOS Emacs installation removed."
}

###############################################################################
# macOS status
###############################################################################

status_macos() {
    local emacs_app="$INSTALL_PREFIX/Emacs.app"
    local client_app="$INSTALL_PREFIX/Emacs Client.app"

    echo "Emacs installation:"
    echo

    if [[ -d "$emacs_app" ]]; then
        echo "✅ $emacs_app"
    else
        echo "❌ $emacs_app"
    fi

    if [[ -d "$client_app" ]]; then
        echo "✅ $client_app"
    else
        echo "❌ $client_app"
    fi

    echo

    if [[ -x "$INSTALL_PREFIX/bin/emacs" ]]; then
        echo "✅ $INSTALL_PREFIX/bin/emacs"
    else
        echo "❌ $INSTALL_PREFIX/bin/emacs"
    fi

    if [[ -x "$INSTALL_PREFIX/bin/emacsclient" ]]; then
        echo "✅ $INSTALL_PREFIX/bin/emacsclient"
    else
        echo "❌ $INSTALL_PREFIX/bin/emacsclient"
    fi

    echo

    local uid
    uid="$(id -u)"

    if launchctl print "gui/$uid/org.gnu.Emacs" >/dev/null 2>&1; then
        echo "✅ Emacs daemon is running."
    else
        echo "⚪ Emacs daemon is not running."
    fi
}

###############################################################################
# Linux icon
###############################################################################

apply_png_icon_linux() {
    local icon_dir
    icon_dir="$(dirname "$(dirname "$SRC_DIR")")/resources/icons"

    local png_file=""

    if [[ -d "$icon_dir" ]]; then
        png_file="$(
            find "$icon_dir" \
                -maxdepth 1 \
                -type f \
                -name '*.png' \
                -print |
                sort |
                head -n 1
        )"
    fi

    [[ -n "$png_file" ]] || return 0
    [[ -f "$png_file" ]] || return 0

    require_command convert

    log "Installing Linux Emacs icons"

    local local_icons="$HOME/.local/share/icons/hicolor"

    for size in 16 24 32 48 64 128 256 512; do
        mkdir -p "$local_icons/${size}x${size}/apps"

        convert \
            "$png_file" \
            -resize "${size}x${size}" \
            "$local_icons/${size}x${size}/apps/emacs.png"
    done

    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache \
            -f \
            -t \
            "$local_icons" \
            2>/dev/null || true
    fi
}

###############################################################################
# Arch Linux
###############################################################################

install_arch() {
    require_command sudo
    require_command pacman
    require_command make
    require_command git
    require_command gcc
    require_command pkg-config
    require_command nproc
    require_command systemctl

    validate_source_tree

    sync_worktree_with_upstream

    log "Installing Arch Linux build dependencies"

    sudo pacman -S --needed \
        base-devel \
        "${arch_build_dependencies[@]}"

    prepare_build_directory

    cd "$SRC_DIR"

    log "Running autogen.sh"
    ./autogen.sh

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    local native_comp_flag
    case "$NATIVE_COMP" in
        aot)      native_comp_flag="--with-native-compilation=aot" ;;
        deferred) native_comp_flag="--with-native-compilation" ;;
        no)       native_comp_flag="--without-native-compilation" ;;
        *)        error "Invalid NATIVE_COMP value: $NATIVE_COMP (use aot, deferred, or no)" ;;
    esac

    log "Configuring Emacs for PGTK"

    "$SRC_DIR/configure" \
        --prefix="/usr/local" \
        --with-pgtk \
        "$native_comp_flag" \
        --with-tree-sitter \
        --with-modules \
        --with-json \
        --with-gnutls \
        --with-rsvg \
        --with-webp \
        --with-xml2 \
        --with-cairo \
        --with-harfbuzz \
        --with-lcms2 \
        --with-sqlite3 \
        --with-mailutils \
        --with-sound=alsa \
        --without-compress-install \
        --enable-link-time-optimization

    local jobs
    jobs="$(nproc)"

    # See the matching comment in install_macos: deep recursion during
    # grammar/leim table generation can overflow the default stack.
    local stack_hard_limit
    stack_hard_limit="$(ulimit -Hs)"
    ulimit -s "$stack_hard_limit" 2>/dev/null ||
        warn "Could not raise stack size limit (currently $(ulimit -s)); grammar/leim generation may segfault"

    log "Building Emacs using $jobs CPU cores"

    make -j"$jobs"

    log "Installing Emacs"

    sudo make install

    apply_png_icon_linux

    [[ -x "/usr/local/bin/emacs" ]] ||
        error "/usr/local/bin/emacs was not installed"

    [[ -x "/usr/local/bin/emacsclient" ]] ||
        error "/usr/local/bin/emacsclient was not installed"

    local service_file="$HOME/.config/systemd/user/emacs.service"

    if [[ -f "$service_file" ]]; then
        log "Reloading Emacs systemd service"

        systemctl --user daemon-reload
        systemctl --user enable --now emacs.service

        systemctl --user is-active --quiet emacs.service ||
            error "Emacs systemd service failed to start"
    else
        warn "No $service_file found; daemon was not configured."
    fi

    echo
    echo "--------------------------------------------------"
    echo "✅ Arch Linux Emacs build complete"
    echo
    echo "   Worktree:     $WORKTREE"
    echo "   Build:        $BUILD_DIR"
    echo "   Installation: /usr/local"
    echo "   PGTK:         yes"
    echo "   Native Comp:  $NATIVE_COMP"
    echo "   Tree-Sitter:  yes"
    echo "   LTO:          yes"
    echo "--------------------------------------------------"
}

###############################################################################
# Arch Linux uninstall
###############################################################################

uninstall_arch() {
    require_command systemctl
    require_command sudo

    local service_file="$HOME/.config/systemd/user/emacs.service"

    if [[ -f "$service_file" ]]; then
        log "Stopping Emacs systemd service"

        systemctl --user disable --now emacs.service 2>/dev/null || true
        systemctl --user daemon-reload
    fi

    if [[ -d "$BUILD_DIR" ]]; then
        log "Removing build directory"
        rm -rf "$BUILD_DIR"
    fi

    local files=(
        /usr/local/bin/emacs
        /usr/local/bin/emacsclient
    )

    local existing=()

    for file in "${files[@]}"; do
        if [[ -e "$file" || -L "$file" ]]; then
            existing+=("$file")
        fi
    done

    if (( ${#existing[@]} > 0 )); then
        log "Removing installed Emacs binaries"
        sudo rm -f "${existing[@]}"
    fi

    for size in 16 24 32 48 64 128 256 512; do
        rm -f \
            "$HOME/.local/share/icons/hicolor/${size}x${size}/apps/emacs.png"
    done

    rm -f "$HOME/.local/share/applications/emacs.desktop"

    echo "✅ Arch Linux Emacs installation removed."
}

###############################################################################
# Arch Linux status
###############################################################################

status_arch() {
    require_command systemctl

    local service_file="$HOME/.config/systemd/user/emacs.service"

    if [[ ! -f "$service_file" ]]; then
        echo "⚪ No Emacs systemd service configured."
    elif systemctl --user is-active --quiet emacs.service; then
        echo "✅ Emacs daemon is running."
        systemctl --user status --no-pager emacs.service
    else
        echo "❌ Emacs daemon is not running."
        systemctl --user status --no-pager emacs.service || true
    fi

    echo

    if [[ -x "/usr/local/bin/emacs" ]]; then
        echo "✅ /usr/local/bin/emacs"
    else
        echo "❌ /usr/local/bin/emacs"
    fi

    if [[ -x "/usr/local/bin/emacsclient" ]]; then
        echo "✅ /usr/local/bin/emacsclient"
    else
        echo "❌ /usr/local/bin/emacsclient"
    fi
}

###############################################################################
# Main
###############################################################################

case "$PLATFORM" in
    macOS)
        if [[ "$UNINSTALL" == true ]]; then
            uninstall_macos
        elif [[ "$STATUS" == true ]]; then
            status_macos
        else
            install_macos
        fi
        ;;

    Linux)
        if ! command -v pacman >/dev/null 2>&1; then
            error "Linux support currently targets Arch Linux only."
        fi

        if [[ "$UNINSTALL" == true ]]; then
            uninstall_arch
        elif [[ "$STATUS" == true ]]; then
            status_arch
        else
            install_arch
        fi
        ;;
esac