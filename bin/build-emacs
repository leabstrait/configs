#!/usr/bin/env bash
set -Eeuo pipefail

###############################################################################
# Configuration
###############################################################################

WORKTREE="${WORKTREE:-master}"
SRC_DIR="${SRC_DIR:-$HOME/ws/i/emacs/worktrees/$WORKTREE}"
BUILD_DIR="${BUILD_DIR:-$HOME/ws/i/emacs/builds/$WORKTREE}"

CLEAN_BUILD=false
UNINSTALL=false
STATUS=false

WORKTREE_OPTION_SET=false

###############################################################################
# Helpers
###############################################################################

log() {
    printf '\n==> %s\n' "$*"
}

error() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'Warning: %s\n' "$*" >&2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        error "Required command not found: $1"
}

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Build and install Emacs from:
  $SRC_DIR

Options:
  --stable           Use the 'stable' worktree and build directory
  --master           Use the 'master' worktree and build directory (default)
  --worktree NAME    Use a custom worktree name and path dynamically
  -c, --clean        Clean the existing build before configuring
  -u, --uninstall    Remove the installed Emacs integration
  -s, --status       Show daemon/service status
  -h, --help         Show this help

Environment:
  SRC_DIR            Override the Emacs source directory
  BUILD_DIR          Override the Emacs build directory
  WORKTREE           Select worktree name
EOF
}

cleanup_on_error() {
    local exit_code=$?
    if (( exit_code != 0 )); then
        printf '\n❌ Build failed with exit code %d.\n' "$exit_code" >&2
    fi
}

trap cleanup_on_error EXIT

###############################################################################
# Package lists
###############################################################################

brew_build_dependencies=(
    make
    autoconf
    gnu-sed
    gnu-tar
    grep
    coreutils
    pkg-config
    texinfo
    xz
    m4
    sqlite
    gnutls
    librsvg
    little-cms2
    tree-sitter
    webp
    mailutils
    libgccjit # for JIT
    gcc      # for JIT
    gmp
    libjpeg
    zlib
    texlive
)

arch_build_dependencies=(
    texinfo
    gnutls
    librsvg
    libxml2
    libwebp
    lcms2
    tree-sitter
    libgccjit
    texlive
    pkgconf
    jansson
    imagemagick
    cairo
    harfbuzz
    sqlite
    alsa-lib
)

###############################################################################
# Argument parsing
###############################################################################

while (($# > 0)); do
    case "$1" in
        --stable)
            [[ "$WORKTREE_OPTION_SET" == false ]] ||
                error "--stable, --master, and --worktree cannot be used together"

            WORKTREE_OPTION_SET=true
            WORKTREE="stable"
            SRC_DIR="$HOME/ws/i/emacs/worktrees/stable"
            BUILD_DIR="$HOME/ws/i/emacs/builds/stable"
            ;;
        --master)
            [[ "$WORKTREE_OPTION_SET" == false ]] ||
                error "--stable, --master, and --worktree cannot be used together"

            WORKTREE_OPTION_SET=true
            WORKTREE="master"
            SRC_DIR="$HOME/ws/i/emacs/worktrees/master"
            BUILD_DIR="$HOME/ws/i/emacs/builds/master"
            ;;
        --worktree)
            [[ "$WORKTREE_OPTION_SET" == false ]] ||
                error "--stable, --master, and --worktree cannot be used together"

            shift
            (($# > 0)) || error "--worktree requires a name argument"

            WORKTREE_OPTION_SET=true
            WORKTREE="$1"
            SRC_DIR="$HOME/ws/i/emacs/worktrees/$WORKTREE"
            BUILD_DIR="$HOME/ws/i/emacs/builds/$WORKTREE"
            ;;
        -c|--clean)
            CLEAN_BUILD=true
            ;;
        -u|--uninstall)
            UNINSTALL=true
            ;;
        -s|--status)
            STATUS=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown parameter: $1" >&2
            usage
            exit 1
            ;;
    esac
    shift
done

if [[ "$UNINSTALL" == true && "$STATUS" == true ]]; then
    error "--uninstall and --status cannot be used together"
fi

###############################################################################
# OS detection
###############################################################################

OS="$(uname -s)"

case "$OS" in
    Darwin)
        PLATFORM="macOS"
        ;;
    Linux)
        PLATFORM="Linux"
        ;;
    *)
        error "Unsupported operating system: $OS"
        ;;
esac

###############################################################################
# macOS (Ruby EmacsBase.rb Converted to Bash)
###############################################################################

create_emacs_client_app() {
    local icons_dir="$1"
    local prefix_path="$2"
    local client_app="$BUILD_DIR/nextstep/Emacs Client.app"
    local client_script="$BUILD_DIR/emacs-client.applescript"

    log "Creating Emacs Client.app"

    local escaped_path="$prefix_path/bin:/usr/bin:/bin:/usr/sbin:/sbin"

    cat << EOF > "$client_script"
-- Emacs Client AppleScript Application
-- Handles opening files from Finder, drag-and-drop, and launching from Spotlight/Dock

on open theDropped
  repeat with oneDrop in theDropped
    set dropPath to quoted form of POSIX path of oneDrop
    try
      do shell script "PATH='$escaped_path' $prefix_path/bin/emacsclient -c -a '' -n " & dropPath
    end try
  end repeat
  try
    do shell script "open -a Emacs"
  end try
end open

on run
  try
    do shell script "PATH='$escaped_path' $prefix_path/bin/emacsclient -c -a '' -n"
  end try
  try
    do shell script "open -a Emacs"
  end try
end run

on open location this_URL
  try
    do shell script "PATH='$escaped_path' $prefix_path/bin/emacsclient -n " & quoted form of this_URL
  end try
  try
    do shell script "open -a Emacs"
  end try
end open location
EOF

    osacompile -o "$client_app" "$client_script"
    rm -f "$client_script"

    local client_plist="$client_app/Contents/Info.plist"
    /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier string org.gnu.EmacsClient" "$client_plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string org.gnu.EmacsClient" "$client_plist"

    /usr/libexec/PlistBuddy -c "Set :CFBundleName string 'Emacs Client'" "$client_plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Add :CFBundleName string 'Emacs Client'" "$client_plist"

    /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName string 'Emacs Client'" "$client_plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string 'Emacs Client'" "$client_plist"

    /usr/libexec/PlistBuddy -c "Set :LSApplicationCategoryType string public.app-category.productivity" "$client_plist" 2>/dev/null || \
        /usr/libexec/PlistBuddy -c "Add :LSApplicationCategoryType string public.app-category.productivity" "$client_plist"

    # Add Document Types and URL schemes for org-protocol
    /usr/libexec/PlistBuddy -c 'Delete :CFBundleDocumentTypes' "$client_plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes array' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0 dict' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0:CFBundleTypeRole string Editor' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0:CFBundleTypeName string "Text Document"' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes array' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:0 string public.text' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:1 string public.plain-text' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:2 string public.source-code' "$client_plist"

    /usr/libexec/PlistBuddy -c 'Delete :CFBundleURLTypes' "$client_plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes array' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0 dict' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0:CFBundleURLName string "Org Protocol"' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes array' "$client_plist"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string org-protocol' "$client_plist"

    local client_resources_dir="$client_app/Contents/Resources"
    [[ -f "$icons_dir/Emacs.icns" ]] && cp "$icons_dir/Emacs.icns" "$client_resources_dir/applet.icns"
    rm -f "$client_resources_dir/droplet.icns" "$client_resources_dir/droplet.rsrc"

    /usr/libexec/PlistBuddy -c 'Delete :CFBundleIconFile' "$client_plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c 'Add :CFBundleIconFile string applet' "$client_plist"
}

install_macos() {
    log "Checking Emacs source tree ($WORKTREE)"

    [[ -d "$SRC_DIR" ]] || error "Emacs source directory not found: $SRC_DIR"
    [[ -f "$SRC_DIR"/configure.ac ]] || error "$SRC_DIR does not appear to be an Emacs source tree"

    log "Installing macOS build dependencies"
    brew install "${brew_build_dependencies[@]}"

    log "Preparing build"
    if [[ "$CLEAN_BUILD" == true ]]; then
        if [[ -f "$BUILD_DIR/Makefile" ]]; then
            log "Performing clean build (make distclean)"
            gmake -C "$BUILD_DIR" distclean || true
        fi
        rm -rf "$BUILD_DIR"
    fi

    local homebrew_prefix
    homebrew_prefix="$(brew --prefix)"
    local install_prefix="$HOME/.local"

    local gcc_ver
    gcc_ver="$(brew info --json=v2 gcc | jq -r '.formulae[0].installed[0].version' 2>/dev/null || true)"
    if [[ -z "$gcc_ver" || "$gcc_ver" == "null" ]]; then
        gcc_ver="$(ls -1 "$homebrew_prefix/lib/gcc" | sort -V | tail -n 1)"
    fi
    local gcc_ver_major="${gcc_ver%%.*}"
    local gcc_lib="$homebrew_prefix/lib/gcc/$gcc_ver_major"

    local sqlite_prefix
    sqlite_prefix="$(brew --prefix sqlite)"
    local gcc_prefix
    gcc_prefix="$(brew --prefix gcc)"
    local libgccjit_prefix
    libgccjit_prefix="$(brew --prefix libgccjit)"

    local cflags=()
    cflags+=("-DFD_SETSIZE=10000")
    cflags+=("-DDARWIN_UNLIMITED_SELECT")
    cflags+=("-I$sqlite_prefix/include")
    cflags+=("-I$gcc_prefix/include")
    cflags+=("-I$libgccjit_prefix/include")

    local ldflags=()
    ldflags+=("-L$sqlite_prefix/lib")
    ldflags+=("-L$gcc_lib")
    ldflags+=("-Wl,-rpath,$gcc_lib")

    export CFLAGS="${cflags[*]}"
    export LDFLAGS="${ldflags[*]}"

    cd "$SRC_DIR"
    log "Running autogen.sh"
    ./autogen.sh

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    log "Configuring Emacs for macOS"
    "$SRC_DIR"/configure \
        --prefix="$install_prefix" \
        --disable-dependency-tracking \
        --disable-silent-rules \
        --enable-locallisppath="$homebrew_prefix/share/emacs/site-lisp" \
        --infodir="$install_prefix/share/info/emacs" \
        --with-ns \
        --disable-ns-self-contained \
        --with-native-compilation=aot \
        --with-tree-sitter \
        --with-modules \
        --with-xwidgets \
        --with-gnutls \
        --with-xml2 \
        --with-rsvg \
        --with-webp \
        --without-imagemagick \
        --without-pop \
        --without-compress-install

    log "Building Emacs using $(sysctl -n hw.ncpu) CPU cores"
    gmake -j"$(sysctl -n hw.ncpu)"
    gmake install

    # Build Emacs Client.app wrapper via native Bash logic
    create_emacs_client_app "$BUILD_DIR/nextstep/Emacs.app/Contents/Resources" "$HOME/.local"

    local app_dir="$BUILD_DIR/nextstep/Emacs.app"
    local client_app_dir="$BUILD_DIR/nextstep/Emacs Client.app"

    if [[ -d "$app_dir" ]]; then
        log "Re-signing Emacs.app for macOS compatibility..."
        codesign --force --deep --sign - "$app_dir"
        rm -rf "$HOME/Applications/Emacs.app"
        cp -R "$app_dir" "$HOME/Applications/Emacs.app"
    fi

    if [[ -d "$client_app_dir" ]]; then
        codesign --force --deep --sign - "$client_app_dir"
        rm -rf "$HOME/Applications/Emacs Client.app"
        cp -R "$client_app_dir" "$HOME/Applications/Emacs Client.app"
    fi

    echo
    echo "--------------------------------------------------"
    echo "✅ macOS Emacs build complete ($WORKTREE)"
    echo "   Cocoa + Native Compilation + Tree-Sitter"
    echo "   Build:        $BUILD_DIR"
    echo "   Application:  $HOME/Applications/Emacs.app"
    echo "--------------------------------------------------"
}

uninstall_macos() {
    require_command launchctl

    local plist_file="$HOME/Library/LaunchAgents/org.gnu.Emacs.plist"
    local uid
    uid="$(id -u)"

    log "Stopping launchd daemon"
    if [[ -f "$plist_file" ]]; then
        launchctl bootout "gui/$uid" "$plist_file" 2>/dev/null || true
        rm -f "$plist_file"
    fi

    if [[ -d "$HOME/Applications/Emacs.app" ]]; then
        log "Removing $HOME/Applications/Emacs.app"
        rm -rf "$HOME/Applications/Emacs.app"
    fi

    if [[ -d "$HOME/Applications/Emacs Client.app" ]]; then
        log "Removing $HOME/Applications/Emacs Client.app"
        rm -rf "$HOME/Applications/Emacs Client.app"
    fi

    echo "✅ macOS Emacs daemon/service integration removed."
}

uninstall_macos_brew_dependencies() {
    require_command brew

    local installed=()
    local package

    for package in "${brew_build_dependencies[@]}"; do
        if brew list --formula "$package" >/dev/null 2>&1; then
            installed+=("$package")
        fi
    done

    if (( ${#installed[@]} == 0 )); then
        log "No target Homebrew dependencies are installed."
        return
    fi

    local leaves=()
    local formula

    while IFS= read -r formula; do
        [[ -n "$formula" ]] || continue
        for package in "${installed[@]}"; do
            if [[ "$formula" == "$package" ]]; then
                leaves+=("$formula")
                break
            fi
        done
    done < <(brew leaves)

    if (( ${#leaves[@]} == 0 )); then
        log "No unused Homebrew build dependencies found."
        return
    fi

    log "Found unused Homebrew build dependencies: ${leaves[*]}"
    read -r -p "Do you want to uninstall these unused dependencies? [y/N] " response
    if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
        brew uninstall "${leaves[@]}"
    else
        log "Leaving unused Homebrew dependencies installed."
    fi
}

status_macos() {
    require_command launchctl

    local uid
    uid="$(id -u)"

    if launchctl print "gui/$uid/org.gnu.Emacs" >/dev/null 2>&1; then
        echo "✅ Emacs daemon is running."
        launchctl print "gui/$uid/org.gnu.Emacs"
    else
        echo "❌ Emacs daemon is not running."
    fi

    echo

    if [[ -d "$HOME/Applications/Emacs.app" ]]; then
        echo "✅ $HOME/Applications/Emacs.app exists."
    else
        echo "❌ $HOME/Applications/Emacs.app does not exist."
    fi
}

###############################################################################
# Arch Linux
###############################################################################

install_arch() {
    require_command sudo
    require_command pacman
    require_command make
    require_command git
    require_command gcc
    require_command pkg-config
    require_command nproc
    require_command systemctl

    log "Checking Emacs source tree ($WORKTREE)"

    [[ -d "$SRC_DIR" ]] || error "Emacs source directory not found: $SRC_DIR"
    [[ -f "$SRC_DIR"/configure.ac ]] || error "$SRC_DIR does not appear to be an Emacs source tree"

    log "Installing Arch Linux build dependencies"
    sudo pacman -S --needed \
        base-devel \
        "${arch_build_dependencies[@]}"

    log "Preparing build"
    if [[ "$CLEAN_BUILD" == true ]]; then
        if [[ -f "$BUILD_DIR/Makefile" ]]; then
            log "Performing clean build (make distclean)"
            make -C "$BUILD_DIR" distclean || true
        fi
        rm -rf "$BUILD_DIR"
    fi

    cd "$SRC_DIR"
    ./autogen.sh

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    "$SRC_DIR"/configure \
        --prefix="/usr/local" \
        --with-pgtk \
        --with-native-compilation=aot \
        --with-tree-sitter \
        --with-modules \
        --with-json \
        --with-gnutls \
        --with-rsvg \
        --with-webp \
        --with-xml2 \
        --with-imagemagick \
        --with-cairo \
        --with-harfbuzz \
        --with-lcms2 \
        --with-sqlite3 \
        --with-mailutils \
        --with-sound=alsa \
        --without-compress-install \
        --enable-link-time-optimization \


    local jobs
    jobs="$(nproc)"

    log "Building Emacs using ${jobs} CPU cores with LTO"
    make -j"$jobs"

    log "Installing Emacs"
    sudo make install

    [[ -x "/usr/local/bin/emacs" ]] || error "Emacs installation failed: /usr/local/bin/emacs not found"
    [[ -x "/usr/local/bin/emacsclient" ]] || error "Emacs installation failed: /usr/local/bin/emacsclient not found"

    if [[ ":$PATH:" != *"/usr/local/bin:"* ]]; then
        warn "/usr/local/bin is not currently in PATH"
    fi

    log "Checking existing systemd user daemon"
    local service_file="$HOME/.config/systemd/user/emacs.service"

    if [[ -f "$service_file" ]]; then
        log "Existing systemd service found"
        systemctl --user daemon-reload
        systemctl --user enable --now emacs.service

        log "Verifying systemd service"
        systemctl --user is-active --quiet emacs.service || error "Emacs systemd service failed to start"

        echo
        echo "--------------------------------------------------"
        echo "✅ Arch Linux Emacs build complete ($WORKTREE)"
        echo "   PGTK + Native Compilation + Tree-Sitter + LTO"
        echo "   Build:        $BUILD_DIR"
        echo "   Installation: /usr/local"
        echo "   Service:      emacs.service"
        echo "--------------------------------------------------"
    else
        warn "No existing $service_file found"
        echo
        echo "--------------------------------------------------"
        echo "✅ Arch Linux Emacs build complete ($WORKTREE)"
        echo "   PGTK + Native Compilation + Tree-Sitter + LTO"
        echo "   Build:        $BUILD_DIR"
        echo "   Installation: /usr/local"
        echo "   Service:      not configured"
        echo "--------------------------------------------------"
    fi
}

uninstall_arch() {
    require_command systemctl
    require_command pacman
    require_command sudo

    local service_file="$HOME/.config/systemd/user/emacs.service"

    if [[ -f "$service_file" ]]; then
        log "Stopping existing Emacs systemd service"
        systemctl --user disable --now emacs.service 2>/dev/null || true
        systemctl --user daemon-reload
    else
        log "No Emacs systemd service file found; skipping service management"
    fi

    log "Removing build files"
    if [[ -d "$BUILD_DIR" ]]; then
        rm -rf "$BUILD_DIR"
    fi

    log "Removing locally installed Emacs"
    local emacs_files=(
        /usr/local/bin/emacs
        /usr/local/bin/emacsclient
    )
    local existing_files=()
    local file

    for file in "${emacs_files[@]}"; do
        if [[ -e "$file" || -L "$file" ]]; then
            existing_files+=("$file")
        fi
    done

    if (( ${#existing_files[@]} > 0 )); then
        sudo rm -f "${existing_files[@]}"
    fi

    local orphans=()
    local current_orphans
    local pkg

    current_orphans="$(pacman -Qdtq 2>/dev/null || true)"

    for pkg in "${arch_build_dependencies[@]}"; do
        if echo "$current_orphans" | grep -qxF "$pkg"; then
            orphans+=("$pkg")
        fi
    done

    if (( ${#orphans[@]} > 0 )); then
        log "Found unused build dependencies safe to remove: ${orphans[*]}"

        read -r -p \
            "Do you want to uninstall these unused dependencies? [y/N] " \
            response

        if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
            sudo pacman -Rns "${orphans[@]}"
        fi
    else
        log "No unused build dependencies found from the target list."
    fi

    echo "✅ Emacs installation and optional systemd integration removed."
}

status_arch() {
    require_command systemctl

    local service_file="$HOME/.config/systemd/user/emacs.service"

    if [[ ! -f "$service_file" ]]; then
        echo "⚠️  No existing Emacs systemd service file found."
    elif systemctl --user is-active --quiet emacs.service; then
        echo "✅ Emacs daemon is running."
        systemctl --user status --no-pager emacs.service
    else
        echo "❌ Emacs daemon is not running."
        systemctl --user status --no-pager emacs.service || true
    fi

    echo

    if [[ -x "/usr/local/bin/emacs" ]]; then
        echo "✅ /usr/local/bin/emacs is installed."
    else
        echo "❌ /usr/local/bin/emacs is not installed."
    fi

    if [[ -x "/usr/local/bin/emacsclient" ]]; then
        echo "✅ /usr/local/bin/emacsclient is installed."
    else
        echo "❌ /usr/local/bin/emacsclient is not installed."
    fi
}

###############################################################################
# Main
###############################################################################

case "$PLATFORM" in
    macOS)
        if [[ "$UNINSTALL" == true ]]; then
            uninstall_macos
            uninstall_macos_brew_dependencies
        elif [[ "$STATUS" == true ]]; then
            status_macos
        else
            install_macos
        fi
        ;;

    Linux)
        if ! command -v pacman >/dev/null 2>&1; then
            error "This Linux branch currently supports Arch Linux only (pacman not found)."
        fi

        if [[ "$UNINSTALL" == true ]]; then
            uninstall_arch
        elif [[ "$STATUS" == true ]]; then
            status_arch
        else
            install_arch
        fi
        ;;
esac